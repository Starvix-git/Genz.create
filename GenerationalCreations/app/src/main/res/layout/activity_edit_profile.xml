<?xml version="1.0" encoding="utf-8"?>
<!-- Edit Profile Screen Layout: Matches Generational Creations e-memo styling -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    tools:context=".EditProfileActivity">

    <!-- Scrollable Body Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Top Navigation Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Back"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Edit Profile"
                    android:textColor="@color/text_ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Avatar Header Container -->
            <RelativeLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp">

                <ImageView
                    android:id="@+id/imgAvatarEdit"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_profile_avatar"
                    android:contentDescription="Profile Photo"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_profile" />

                <ImageView
                    android:id="@+id/btnChangeAvatarPhoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/bg_badge_camera"
                    android:clickable="true"
                    android:contentDescription="Change Photo"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_camera" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Change profile photo"
                android:textColor="@color/color_gold_deep"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Form Pad Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <!-- Full Name Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_pill"
                    android:paddingHorizontal="18dp">

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Full Name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:text="Jordan"
                        android:textColor="@color/text_ink"
                        android:textColorHint="@color/text_muted"
                        android:textSize="15.5sp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Job Title / Role Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Role / Occupation"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_pill"
                    android:paddingHorizontal="18dp">

                    <EditText
                        android:id="@+id/etRole"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Role"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:text="Graphics designer"
                        android:textColor="@color/text_ink"
                        android:textColorHint="@color/text_muted"
                        android:textSize="15.5sp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Email Address Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Email Address"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_pill"
                    android:paddingHorizontal="18dp">

                    <EditText
                        android:id="@+id/etEditEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Email Address"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:text="jordanahimbisibwe160@gmail.com"
                        android:textColor="@color/text_ink"
                        android:textColorHint="@color/text_muted"
                        android:textSize="15.5sp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Bio Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Bio / Tagline"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_pill"
                    android:paddingHorizontal="18dp">

                    <EditText
                        android:id="@+id/etBio"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Bio"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:text="Imagine, Create, Inspire"
                        android:textColor="@color/text_ink"
                        android:textColorHint="@color/text_muted"
                        android:textSize="15.5sp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Save Changes Submit Button -->
                <FrameLayout
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_btn_gold"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Save changes"
                        android:textColor="@color/text_ink"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>